{
  "name": "@theokit/skills",
  "version": "0.4.1",
  "description": "Installs the TheoKit ecosystem agent skills into every AI coding tool you use — Claude Code, OpenAI Codex, Gemini CLI, GitHub Copilot, Zed, Devin Desktop — on Windows, macOS and Linux. Zero dependencies; links where that follows your lockfile, copies where it cannot.",
  "type": "module",
  "bin": {
    "theokit-skills": "./bin/install.mjs"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "README.md",
    "LICENSE",
    "scripts"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/usetheokit/theokit-skills#readme",
  "bugs": "https://github.com/usetheokit/theokit-skills/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-skills.git"
  },
  "keywords": [
    "theokit",
    "theokit-sdk",
    "agent-skills",
    "claude-code",
    "codex",
    "gemini-cli",
    "github-copilot",
    "zed",
    "cursor",
    "ai-agents",
    "skills",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync-references": "node scripts/sync-references.mjs",
    "test": "node --test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@theokit/sdk": "^4.53.1"
  }
}
