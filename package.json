{
  "name": "@theokit/skill",
  "version": "0.3.0",
  "description": "npx installer for the theokit-sdk Claude Code skill — teaches Claude Code the @theokit/sdk surface (Agent.create/prompt, Tool.create, streaming SDKMessage events, MCP, subagents, cron, memory, errors) so it writes correct SDK code. Verified against the shipped type declarations.",
  "type": "module",
  "bin": {
    "theokit-skill": "./bin/install.mjs"
  },
  "files": [
    "bin",
    "skills",
    "README.md",
    "LICENSE",
    "scripts"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/usetheokit/theokit-skill#readme",
  "bugs": "https://github.com/usetheokit/theokit-skill/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheokit/theokit-skill.git"
  },
  "keywords": [
    "theokit",
    "theokit-sdk",
    "claude-code",
    "claude-skill",
    "ai-agents",
    "typescript",
    "agent-sdk",
    "llm",
    "skill"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync-references": "node scripts/sync-references.mjs",
    "test": "node --test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@theokit/sdk": "^4.2.8"
  }
}
